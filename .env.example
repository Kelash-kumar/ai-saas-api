NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_NAME=auth-foundation
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_NAME=auth_foundation
DATABASE_USER=foundation
DATABASE_PASSWORD=change-this-local-password
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=3000
AUTH_JWT_KEY=
AUTH_CSRF_KEY=
AUTH_OUTBOX_KEY=
AUTH_OUTBOX_KEY_ID=local-v1
AUTH_JWT_ISSUER=auth-foundation
AUTH_JWT_AUDIENCE=foundation-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_VERIFICATION_TTL_SECONDS=3600
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_RESET_TTL_SECONDS=1800
AUTH_ACTIVATION_TTL_SECONDS=3600
MAIL_TRANSPORT=file
MAIL_FROM=no-reply@example.test
MAIL_PUBLIC_URL=http://localhost:3001
MAIL_TIMEOUT_MS=5000
MAIL_LEASE_MS=60000
MAIL_MAX_ATTEMPTS=5
MAIL_POLL_MS=1000
# Required only for MAIL_TRANSPORT=smtp; TLS required in production.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Optional development seed overrides. Production requires explicit non-default values.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
